APP_NAME="Paayu Attire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
# Local address only. DO NOT change this to the dev-tunnel URL when sharing
# via VS Code port forwarding: bootstrap/app.php trusts the tunnel's
# X-Forwarded-Host / X-Forwarded-Proto headers, and local assets /
# storage URLs are host-relative, so the forwarded https://*.devtunnels.ms
# URL works with APP_URL left as localhost. Changing APP_URL to the
# tunnel URL would break the next tunnel session (the host changes).
APP_URL=http://localhost:8000
# Leave unset (assets are served from the current host). Set only for a CDN.
# ASSET_URL=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paayu_attire
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google login (Socialite). For login via a forwarded tunnel URL, this must
# be the tunnel callback, e.g.
# GOOGLE_REDIRECT_URI=https://<tunnel-id>.devtunnels.ms/auth/google/callback
# AND that exact URL must be registered as an authorized redirect URI in
# Google Cloud Console — Google rejects unregistered redirect URIs, so
# this one cannot be fixed in code alone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

VITE_APP_NAME="${APP_NAME}"
